# Copy to ~/rc-signal/rc-signal.env (user unit) or /etc/rc-signal.env (system unit), mode 0600.
# Browser origins that may call the service (comma separated, no paths).
RC_SIGNAL_ORIGINS=https://rc.aldine.cn
RC_SIGNAL_HOST=127.0.0.1
RC_SIGNAL_PORT=8787
# Behind Cloudflare Tunnel the client address is in CF-Connecting-IP.
RC_SIGNAL_TRUST_CF=1
# Cloudflare Realtime TURN key. Leave both empty to run without a relay.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
RC_TURN_TTL_SECONDS=3600
RC_TURN_DAILY_LIMIT=2000
